#!/usr/bin/env bash
# Auto-generated: run the ORFS flow (GNU make) from the ORFS Docker image as if
# it were a host binary.
#
# Unlike the yosys/sta/eqy wrappers, this one does NOT run in $PWD. ORFS is
# driven from its own flow directory, and the image ships a matched set of flow
# scripts and tool binaries -- so make runs against the IMAGE's
# /OpenROAD-flow-scripts/flow, exactly as ORFS's own util/docker_shell does.
# Using the host clone's scripts against the image's binaries would couple two
# independently-versioned trees.
#
# WORK_HOME is supplied per-run by adapters/orfs.py, which points it at the
# stage directory so results, logs, reports and objects land inside the Nebula
# run tree rather than in the ORFS checkout.
set -euo pipefail
REPO_ROOT="${NEBULA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)}"
IMAGE="${NEBULA_ORFS_IMAGE:-openroad/orfs:latest}"
exec docker run --rm \
  -u "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  -e FLOW_HOME=/OpenROAD-flow-scripts/flow \
  -e YOSYS_EXE=/OpenROAD-flow-scripts/tools/install/yosys/bin/yosys \
  -e OPENROAD_EXE=/OpenROAD-flow-scripts/tools/install/OpenROAD/bin/openroad \
  -e KLAYOUT_CMD=/usr/bin/klayout \
  -v "$REPO_ROOT:$REPO_ROOT" \
  -w /OpenROAD-flow-scripts/flow \
  "$IMAGE" \
  make "$@"
