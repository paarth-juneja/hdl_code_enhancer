#!/usr/bin/env bash
# Run OpenSTA from the ORFS Docker image as if it were a host binary.
set -euo pipefail
REPO_ROOT="${NEBULA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)}"
IMAGE="${NEBULA_ORFS_IMAGE:-openroad/orfs:latest}"
mounts=(-v "$REPO_ROOT:$REPO_ROOT")
case "$PWD/" in
  "$REPO_ROOT/"*) ;;
  *) mounts+=(-v "$PWD:$PWD") ;;
esac
exec docker run --rm \
  -u "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  "${mounts[@]}" \
  -w "$PWD" \
  "$IMAGE" \
  /OpenROAD-flow-scripts/tools/install/OpenROAD/bin/sta "$@"
