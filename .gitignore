# ─── Generated run artifacts ───────────────────────────────
# Reproducible from the manifest, not source.
/runs/
/candidates/
/experiments/

# Throwaway driver for exercising the real backend by hand; not part of the
# orchestrator and not required by any test.
/scratch_real_screen.py

# ─── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local API credentials. Keep the example file tracked.
.env

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ─── EDA tool transients ───────────────────────────────────
# Note: source lives in rtl/ and tests/fixtures/ and is NOT ignored
# (*.v, *.sdc, *.tmpl are tracked). These are throwaway tool outputs.
*.log
*.jou
*.vcd
*.fst
yosys.log
slpp_all/

# ─── Claude Code (per-machine, not shared) ─────────────────
.claude/settings.local.json

# ─── Rendered docs (keep the .md sources, not the binaries) ─
# Regenerated from the markdown; excluded to keep history clean.
*.pdf
*.docx

# ─── OS / editor cruft ─────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.idea/

# Benchmark run trees (same rule as the top-level /runs/).
/benchmarks/*/runs/
/benchmarks/*/candidates/
/benchmarks/*/experiments/
